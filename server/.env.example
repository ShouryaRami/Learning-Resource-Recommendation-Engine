# Server port (Render assigns this automatically)
PORT=

# MongoDB Atlas connection string
# Format: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB_URI=

# JWT secret key — use a long random string
JWT_SECRET=

# JWT token expiry duration
JWT_EXPIRES_IN=

# Google OAuth credentials (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Gmail App Password for sending OTP emails
# Important: this is NOT your regular Gmail password
# Generate at: myaccount.google.com -> Security -> App passwords
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=

# Gemini AI API key (get from aistudio.google.com)
GEMINI_API_KEY=

# YouTube Data API v3 key (get from console.cloud.google.com)
YOUTUBE_API_KEY=

# Frontend URL used for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173
